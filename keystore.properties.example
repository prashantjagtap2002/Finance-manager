# Copy to keystore.properties (gitignored) and fill in to produce a signed release build.
#
# Create the keystore once, and keep the file and these passwords backed up somewhere safe —
# losing them means you can never publish an update to the same Play listing again:
#
#   keytool -genkeypair -v -keystore finance-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias finance
#
# CI can supply the same four values as environment variables instead:
#   FINANCE_KEYSTORE_FILE, FINANCE_KEYSTORE_PASSWORD, FINANCE_KEY_ALIAS, FINANCE_KEY_PASSWORD
#
# With neither configured, `assembleRelease` still builds — it just leaves the APK unsigned.

storeFile=finance-release.jks
storePassword=
keyAlias=finance
keyPassword=

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BIND_NOTIFICATION_LISTENER_SERVICE is deliberately NOT requested here. It is a
         signature-level permission the system grants to itself, not something an app can hold;
         declaring it made lint fail and granted nothing. The listener service below carries it as
         android:permission instead, which is the half that actually matters: it is what stops
         anything but the system binding to the service. -->

    <!-- Required for Supabase cloud sync -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- SMS permissions for bank transaction capture -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>

    <!-- Requesting an SMS permission implies telephony hardware, which would keep the app off
         every Wi-Fi-only tablet and Chromebook. SMS capture is one optional feature among many,
         so the requirement is declared explicitly optional. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>

    <!-- Budget alerts, bill reminders and goal milestones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- PDF export to the public Downloads folder on API < 29 (scoped storage handles 29+) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.FinanceManager">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification Listener Service for UPI Alerts -->
        <service
            android:name=".services.SmsNotificationListenerService"
            android:label="Finance Auto Log Service"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- App Widget Provider. APPWIDGET_UPDATE has to be listed and the receiver has to be
             exported for the system to drive the widget at all. The app's own UPDATE_WIDGET action
             is deliberately NOT in the filter: an action in the filter of an exported receiver is
             an entry point any installed app can trigger, and this one only ever needs to be sent
             from inside the app, where an explicit intent reaches it without a filter. -->
        <receiver
            android:name=".services.FinanceWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- The other widgets follow the same rule as the one above. -->
        <receiver
            android:name=".services.widgets.AllowanceWidgetProvider"
            android:label="@string/widget_allowance_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_allowance_info" />
        </receiver>
        <receiver
            android:name=".services.widgets.WeekWidgetProvider"
            android:label="@string/widget_week_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <receiver
            android:name=".services.widgets.UpcomingWidgetProvider"
            android:label="@string/widget_upcoming_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_info" />
        </receiver>

        <!-- "Mark paid" on a bill reminder. Not exported: only the app's own PendingIntent, which
             names it explicitly, can reach it. -->
        <receiver
            android:name=".services.BillActionReceiver"
            android:exported="false" />

        <!-- Hands the camera app a private file to write a receipt photo into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- SMS Receiver for Bank Transaction Capture -->
        <receiver
            android:name=".services.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

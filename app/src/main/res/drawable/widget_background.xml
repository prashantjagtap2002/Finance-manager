<?xml version="1.0" encoding="utf-8"?>
<!-- Brushed titanium, top-left to bottom-right, with a gold hairline: the in-app HeroCard. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/widget_hero_end"
        android:startColor="@color/widget_hero_start"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_edge" />
    <corners android:radius="24dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Holds the Supabase access/refresh tokens in plaintext; excluded so a restored
             cloud backup can't be used to resume another device's cloud session. -->
        <exclude domain="sharedpref" path="supabase_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="supabase_session.xml"/>
    </device-transfer>
</data-extraction-rules>
<full-backup-content>
    <!-- Holds the Supabase access/refresh tokens in plaintext; excluded so a restored
         backup can't be used to resume another device's cloud session. -->
    <exclude domain="sharedpref" path="supabase_session.xml"/>
</full-backup-content>
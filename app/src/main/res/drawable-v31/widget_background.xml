<?xml version="1.0" encoding="utf-8"?>
<!-- As drawable/widget_background, with the launcher's own corner radius so the widget's corners
     match every other widget's. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/widget_hero_end"
        android:startColor="@color/widget_hero_start"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_edge" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>

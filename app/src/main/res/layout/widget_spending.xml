<?xml version="1.0" encoding="utf-8"?>
<!-- "Spending today": today's total, this cycle against its budget, and up to three of the
     tightest envelopes. One layout for every size above the 2x1 strip; the provider hides envelope
     rows to fit, picking the row count from heights measured off this layout:
       padding 28 + header 44 + cycle line 18          =  90dp, no rows
       each row: 10 margin + 17 text + 5 gap + 5 bar   = +36dp
     The old version showed three rows from 190dp, but three need about 200dp plus slack, so on a
     4x2 Pixel the third row was cut through the middle.
     The sample text is what the widget picker's preview shows; every value is replaced on bind.
     The root carries @android:id/background so Android 12+ animates the app launch out of the
     widget, and clipToOutline keeps content inside the launcher's rounded corners. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SPENT TODAY"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="₹420"
                android:textColor="@color/widget_on_surface"
                android:textSize="26sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_button_bg"
            android:contentDescription="@string/widget_quick_add"
            android:padding="9dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_cycle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="₹8,683 of ₹15,930 this cycle"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/w_env1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_env1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Groceries"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_env1_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="₹1,240 left"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_env1_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:max="1000"
            android:progress="620"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_env2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_env2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Dining out"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_env2_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="₹380 left"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_env2_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:max="1000"
            android:progress="880"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_env3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_env3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Travel"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_env3_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="₹2,100 left"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_env3_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="5dp"
            android:max="1000"
            android:progress="300"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Set envelope budgets to track them here"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>

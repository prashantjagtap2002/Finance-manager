<?xml version="1.0" encoding="utf-8"?>
<!-- "Coming up": the next bills, IOUs and recurring income due in the next 30 days (overdue first),
     and what friends owe against what is owed to them. Rows hide when there are fewer items. The
     sample text is the picker preview; every value is replaced on bind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="COMING UP"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_due_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="₹13,999 out in 30 days"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_due1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_due1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rent"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_due1_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="in 3 days"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_due1_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="₹12,000"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_due2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_due2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Pay Rahul"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_due2_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="in 5 days"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_due2_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="₹1,500"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_due3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_due3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Netflix"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_due3_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="in 12 days"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_due3_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="₹499"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_due_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Nothing due in the next 30 days"
        android:textColor="@color/widget_on_surface"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Spacer and divider are FrameLayouts, not plain Views: RemoteViews refuses to inflate
         android.view.View on every API level, and one would leave the whole widget showing
         "Can't load widget". -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_owed_to_you"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Owed to you ₹3,200"
            android:textColor="@color/widget_ok"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_you_owe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="You owe ₹1,500"
            android:textColor="@color/widget_warn"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- "Last 7 days": the last seven days as bars (drawn by the provider into w_chart, since a widget
     can't draw), the total against the seven days before, and where most of it went. The sample
     text is the picker preview; every value is replaced on bind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="LAST 7 DAYS"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_week_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="₹4,820"
                android:textColor="@color/widget_on_surface"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_week_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/widget_chip_bg"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="12% less than before"
            android:textColor="@color/widget_ok"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_week_chart"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/w_week_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Most on Food &amp; Dining · ₹2,340"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
